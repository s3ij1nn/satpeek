APP_NAME=SatPeek
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# --- Seeded admin account ---
# DatabaseSeeder writes a single admin User row with these credentials and
# re-syncs the password whenever this value changes. OVERRIDE in production —
# the defaults here are local-dev only.
ADMIN_EMAIL=admin@satpeek.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=satpeek
DB_USERNAME=satpeek
DB_PASSWORD=satpeek

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

HTTP_PORT=8080

# Mail — defaults route to Mailpit (UI: http://localhost:8025).
# In production, override MAIL_MAILER / MAIL_HOST / MAIL_PORT / MAIL_USERNAME /
# MAIL_PASSWORD / MAIL_ENCRYPTION to point at SES, Postmark, SendGrid, etc.
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@satpeek.com
MAIL_FROM_NAME="SatPeek"
MAILPIT_HTTP_PORT=8025
MAILPIT_SMTP_PORT=1025

# --- SatPeek-specific ---

# FaucetPay
FAUCETPAY_API_KEY=
FAUCETPAY_API_BASE=https://faucetpay.io/api/v1
FAUCETPAY_MIN_WITHDRAW_SAT=1000

# Offerwall adapters — comma-separated. Default ships only the in-platform
# inventory (admin-managed PTC ads / shortlinks via Filament). Add `bitcotask`
# *only after* BitcoTask has reviewed and approved your publisher application.
OFFERWALLS_ENABLED=

# BitcoTask — leave empty until your publisher account is approved. When the
# core values are set you can flip OFFERWALLS_ENABLED to include `bitcotask`.
# BITCOTASK_API_KEY is the per-publisher key embedded in the request URL
# path (/<api>/<API_KEY>/<USER_ID>/<USER_IP>). BITCOTASK_BEARER_TOKEN is the
# separate API auth secret sent as `Authorization: Bearer <token>` on every
# REST call (PTC / sl-api / ra-api). Both are issued from the BitcoTasks
# publisher dashboard.
BITCOTASK_PUBLISHER_ID=
BITCOTASK_API_KEY=
BITCOTASK_BEARER_TOKEN=
BITCOTASK_API_BASE=https://bitcotasks.com
BITCOTASK_S2S_SECRET=
# USD-to-satoshi conversion for the postback's `payout` field. Operator-
# supplied because BitcoTasks doesn't quote a fixed rate. Leave 0 to ack
# postbacks but credit nothing (useful while testing).
BITCOTASK_USD_TO_SAT=0
# Comma-separated IP allowlist for inbound BitcoTasks postbacks. Default
# is the address BitcoTasks publishes in their docs.
BITCOTASK_IP_ALLOWLIST=45.14.135.48

# URL-shortener publisher APIs. Each token is the operator's account
# credential (NOT a per-user secret). Leave any of these blank — providers
# with no token are simply hidden in the Filament "Shorten via…" picker.
# Add new entries by mirroring the pattern in config/satpeek.php under
# `shortlink_providers`. ouo.io is intentionally absent — it needs a
# separate path-token transport that this generic client does not implement.
BTCUT_API_TOKEN=
BTCUT_API_BASE=https://btcut.io/api
CUTY_API_TOKEN=
CUTY_API_BASE=https://cuty.io/api
EXE_API_TOKEN=
EXE_API_BASE=https://exe.io/api
SHRTFLY_API_TOKEN=
SHRTFLY_API_BASE=https://shrtfly.com/api
# ouo.io uses a different transport: token sits in the path, response is
# plain text. The OuoShortenerClient handles the difference; same env shape.
OUO_API_TOKEN=
OUO_API_BASE=https://ouo.io/api

# Captcha policy. TTL = how long after issue the server accepts a verify
# request. Bumped to 5 min so users have time to fill forms / watch ads
# before solving. CAPTCHA_MAX_SOLVE_MS (60 s) is the scripted-attack window
# from challenge issue to verify; the captcha component also auto-refreshes
# stale challenges on pointerenter so the window restarts when the user
# actually engages the canvas. 60 s comfortably covers
# type-email + type-password + 6-10 s drag + click; human-relay services
# round-trip in 30-90 s and still fail more often than not.
CAPTCHA_TTL_MS=300000
CAPTCHA_MIN_SOLVE_MS=800
CAPTCHA_MAX_SOLVE_MS=60000
CAPTCHA_MIN_POINTS=20
# 1000 Hz polling × 5 s drag easily breaches 600. Bumped so high-DPI mice
# don't false-reject regular human drags.
CAPTCHA_MAX_POINTS=2000
# Tolerance knobs — relax if real users see false rejects, tighten if bots leak through.
CAPTCHA_SHAPE_TOLERANCE_PX=48
CAPTCHA_DT_MEDIAN_MS_MIN=8
CAPTCHA_DT_MEDIAN_MS_MAX=80
CAPTCHA_DT_JITTER_RATIO_MIN=0.10
CAPTCHA_DWELL_MS_MIN=100
CAPTCHA_DWELL_RADIUS_PX=8
CAPTCHA_JERK_ENTROPY_MIN=1.2

# Bot scoring tier thresholds
BOTSCORE_SUSPECT=0.30
BOTSCORE_LIKELY_BOT=0.60
BOTSCORE_BAN=0.85
# Min seconds between automatic ScoreEngine re-evaluations driven by
# `evaluateThrottled()`. Tight enough that a login/register burst from
# a sock-puppet operator still triggers a fresh score on the first hit;
# loose enough that a chatty user doesn't bombard the signal queries.
BOTSCORE_MIN_REEVAL_SECONDS=300

# SharedIpSignal — multi-account-by-IP detection. Tunable thresholds for
# environments with shared NAT (campus, mobile, household routers). Defaults
# treat 1 sibling account as a soft suspect signal and 3+ siblings as
# strongly bot-like; combined with the 0.15 weight this pushes a 3-sibling
# user past the suspect threshold (0.30) even when every other signal is
# clean. Raise `min_others` to 2 or 3 in shared-NAT-heavy environments.
BOTSCORE_SHARED_IP_MIN_OTHERS=1
BOTSCORE_SHARED_IP_SCORE_PER_OTHER=0.3
BOTSCORE_SHARED_IP_MAX_SCORE=1.0
# Comma-separated CIDR or single-IP allowlist for known shared NATs.
# Allowlisted IPs are excluded from the cross-account count so legit
# users on campus / mobile / corporate networks don't false-positive.
# Browse /admin/user-ip-observations and add the noisy shared IPs here
# after spotting them. Both IPv4 and IPv6 prefix syntax accepted.
# Example: BOTSCORE_SHARED_IP_ALLOWLIST=10.0.0.0/8,2001:db8::/32,203.0.113.42
BOTSCORE_SHARED_IP_ALLOWLIST=

# Datacenter ASN list (comma-separated, override in production)
DATACENTER_ASNS=14061,16509,8075,16276,24940,200000,396982,63949

# Anti-adblock gate. Browser-side probe POSTs to /api/adblock/report on
# every authenticated page load with adblock_detected + brave_detected
# flags. AdblockGate refuses earning routes (PTC start / shortlink start
# / withdraw) when the report is `detected` OR older than this TTL —
# the stale=blocked rule is the anti-bypass measure (a bot that simply
# never POSTs the report can't claim "clean" by default).
ADBLOCK_CHECK_TTL_SECONDS=300

# Cloudflare orange-cloud (proxy mode) — when true, the CloudflareClientIp
# middleware reads the real visitor IP from the `CF-Connecting-IP` header
# Cloudflare sets on every relayed request. Off by default — local dev /
# non-Cloudflare deployments stay on the connection IP.
#
# IMPORTANT: only enable this when the origin firewall restricts inbound
# traffic to Cloudflare's published IP ranges (https://www.cloudflare.com/ips/).
# Otherwise an attacker reaching the origin directly could spoof
# CF-Connecting-IP and bypass bot detection / IP reputation / captcha
# fingerprint locking.
TRUST_CLOUDFLARE_PROXY=false

# IP reputation providers — leave keys empty to disable a given provider.
# IPHub:       sign up at https://iphub.info/api  (free tier: 1000 lookups/day)
# ProxyCheck:  sign up at https://proxycheck.io/  (free tier: 1000 daily, anon: 100/day)
# Hard off-switch (auto-on when APP_ENV=local|testing)
IP_REPUTATION_DISABLED=false
IPHUB_API_KEY=
IPHUB_API_BASE=https://v2.api.iphub.info
PROXYCHECK_API_KEY=
PROXYCHECK_API_BASE=https://proxycheck.io/v2
IP_REPUTATION_CACHE_TTL=86400
IP_REPUTATION_CACHE_NEG_TTL=600
IP_REPUTATION_GATE_MIN_RISK=70
# MaxMind GeoLite2-ASN — local .mmdb path (no API key, no quota).
# Sign up at https://www.maxmind.com/, download GeoLite2-ASN.mmdb (~7 MB),
# mount it into the container at this path. Leave blank to disable.
# Updated by `geoipupdate` in production; the file lives outside git for
# license reasons.
MAXMIND_ASN_DB=

# Referral commission percent (0-100)
REFERRAL_COMMISSION_PCT=10

# Self-serve advertising — users submit their own PTC ads from /advertise.
# Cost per view = reward_sat × (1 + ADS_COMMISSION_PCT / 100). Approval is
# admin-mediated by default; flip ADS_AUTO_APPROVE=true to skip review.
ADS_COMMISSION_PCT=25
ADS_AUTO_APPROVE=false
ADS_REWARD_MIN_SAT=1
ADS_REWARD_MAX_SAT=100
ADS_DURATION_MIN_SEC=5
ADS_DURATION_MAX_SEC=120
ADS_VIEWS_MIN=100
ADS_VIEWS_MAX=1000000
